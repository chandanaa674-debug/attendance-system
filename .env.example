# TechBots-SIT RFID Attendance Management System Configuration

# Flask Server Config
FLASK_ENV=production
DEBUG=False
PORT=5000
HOST=0.0.0.0

# Timezone (Asia/Kolkata for Mangaluru, Karnataka, India)
TIMEZONE=Asia/Kolkata

# Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TechBots@SIT2026
JWT_SECRET=techbots-sit-jwt-secret-key-replace-in-production

# RFID Hardware Authentication Secret (Must match ESP32 X-API-Key header)
RFID_API_SECRET=techbots-sit-rfid-hw-secret-2026

# Rapid Scan Cooldown (Debounce in seconds to prevent duplicate scans)
RAPID_SCAN_COOLDOWN_SECONDS=15

# Storage Configuration (Paths relative to project root or absolute)
MEMBERS_EXCEL_PATH=data/club_members.xlsx
ATTENDANCE_EXCEL_PATH=data/attendance_records.xlsx
BACKUP_DIR=data/backups
